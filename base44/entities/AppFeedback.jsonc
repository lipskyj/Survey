{
  "name": "AppFeedback",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "bug",
        "suggestion",
        "compliment",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e9\u05d5\u05d1"
    },
    "message": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05de\u05e9\u05d5\u05d1"
    },
    "page": {
      "type": "string",
      "description": "\u05d4\u05d3\u05e3 \u05e9\u05de\u05de\u05e0\u05d5 \u05e0\u05e9\u05dc\u05d7 \u05d4\u05de\u05e9\u05d5\u05d1"
    },
    "user_email": {
      "type": "string",
      "description": "\u05de\u05d9\u05d9\u05dc \u05d4\u05e9\u05d5\u05dc\u05d7"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05e7\u05e8\u05d0 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d0\u05d3\u05de\u05d9\u05df"
    }
  },
  "required": [
    "type",
    "message"
  ]
}